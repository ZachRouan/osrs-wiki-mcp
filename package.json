{
  "name": "osrs-wiki-mcp",
  "version": "1.0.0",
  "description": "Remote MCP server exposing the Old School RuneScape Wiki and live player data as tools, on Cloudflare Workers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZachRouan/osrs-wiki-mcp.git"
  },
  "license": "MIT",
  "author": "Zach Rouan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector",
    "smoke": "node scripts/smoke-player-apis.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "^0.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260623.1",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.104.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
